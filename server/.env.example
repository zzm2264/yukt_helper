# ==========================================
# 雨课堂云端同步与 AI 答题服务端环境配置模板
# 复制本文件为 .env 并在运行前配置参数:
# cp .env.example .env
# ==========================================

# 服务端管理员访问密钥 (用于 /api/sync/keys 等管理操作，请务必修改为强密码)
YKT_ADMIN_KEY=your_secure_admin_key_here

# 服务监听地址与端口
YKT_BIND_HOST=0.0.0.0
YKT_PORT=5000
YKT_HTTP_THREADS=24

# 数据存储目录 (默认保存在 server/data)
YKT_DATA_DIR=./data

# 单次同步最大账号数量
YKT_MAX_ACCOUNTS_PER_SYNC=500

# 速率限制配置 (次/分钟)
YKT_API_RATE_LIMIT=300
YKT_AI_RATE_LIMIT=60

# ==========================================
# AI 智能答题引擎配置 (可选)
# 支持 OpenAI、DeepSeek、阿里通义千问等兼容接口
# 若不配置，AI 答题接口将安全进入静默待命模式
# ==========================================
YKT_AI_API_KEY=sk-your-ai-api-key-here
YKT_AI_BASE_URL=https://api.deepseek.com/v1
YKT_AI_MODEL=deepseek-chat
YKT_AI_PROVIDER=deepseek
YKT_AI_TIMEOUT=20
